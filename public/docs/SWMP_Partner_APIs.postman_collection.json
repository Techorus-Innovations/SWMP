    {
      "name": "5. Inbound Requests",
      "description": "Create inbound delivery requests synchronized directly with SAP.",
      "item": [
        {
          "name": "Create Inbound Delivery Request",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date();",
                  "d.setDate(d.getDate() + 5);",
                  "const yyyy = d.getFullYear();",
                  "const mm = String(d.getMonth() + 1).padStart(2, '0');",
                  "const dd = String(d.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('sample_delivery_date', `${yyyy}-${mm}-${dd}`);",
                  "",
                  "// Manufacture date: 30 days before delivery date",
                  "const mfg = new Date(d);",
                  "mfg.setDate(mfg.getDate() - 30);",
                  "const mfgStr = `${mfg.getFullYear()}-${String(mfg.getMonth() + 1).padStart(2, '0')}-${String(mfg.getDate()).padStart(2, '0')}`;",
                  "pm.variables.set('mfg_date', mfgStr);",
                  "",
                  "// Expiration date: 2 years after delivery date",
                  "const exp = new Date(d);",
                  "exp.setFullYear(exp.getFullYear() + 2);",
                  "const expStr = `${exp.getFullYear()}-${String(exp.getMonth() + 1).padStart(2, '0')}-${String(exp.getDate()).padStart(2, '0')}`;",
                  "pm.variables.set('exp_date', expStr);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contract_code\": \"{{sample_contract_code}}\",\n  \"delivery_date\": \"{{sample_delivery_date}}\",\n  \"delivery_time\": \"09\",\n  \"products\": [\n    {\n      \"gtin\": \"{{sample_gtin}}\",\n      \"quantity\": 100,\n      \"batch\": \"BATCH-01\",\n      \"manufacture_date\": \"{{mfg_date}}\",\n      \"expiration_date\": \"{{exp_date}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/inbound-requests",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "inbound-requests"
              ]
            },
            "description": "Validates material GTIN codes, auto-resolves storage location from the material's first permitted area, verifies contract eligibility and slot capacity, then pushes the request to SAP."
          },
          "response": [
            {
              "name": "201 Inbound Request Created",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"inbound_id\": \"10009210\",\n  \"message\": \"Inbound request created successfully in SAP.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "6. Outbound Requests",
      "description": "Create outbound delivery requests synchronized directly with SAP.",
      "item": [
        {
          "name": "Create Outbound Delivery Request",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date();",
                  "d.setDate(d.getDate() + 5);",
                  "const yyyy = d.getFullYear();",
                  "const mm = String(d.getMonth() + 1).padStart(2, '0');",
                  "const dd = String(d.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('sample_delivery_date', `${yyyy}-${mm}-${dd}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delivery_service\": true,\n  \"ship_to_party_gln\": \"{{sample_gln}}\",\n  \"delivery_date\": \"{{sample_delivery_date}}\",\n  \"delivery_time_slot\": \"11\",\n  \"products\": [\n    {\n      \"product_gtin\": \"{{sample_gtin}}\",\n      \"batch_code\": \"BATCH-01\",\n      \"quantity\": 25\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/outbound-requests",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "outbound-requests"
              ]
            },
            "description": "Validates outbound delivery against stock inventory, verifies slot capacity, auto-allocates stock batch locations, and submits the request to SAP."
          },
          "response": [
            {
              "name": "201 Outbound Request Created",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"outbound_id\": \"O800123\",\n  \"message\": \"Outbound request created successfully in SAP.\"\n}"
            }
          ]
        }
      ]
    }
  ]
