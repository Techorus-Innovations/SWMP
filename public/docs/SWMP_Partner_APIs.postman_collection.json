    {
      "name": "3. Delivery Slots",
      "description": "Query available warehouse delivery slot capacities for inbound and outbound operations.",
      "item": [
        {
          "name": "Get Inbound Delivery Slots",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const target = new Date();",
                  "target.setDate(target.getDate() + 5);",
                  "const yyyy = target.getFullYear();",
                  "const mm = String(target.getMonth() + 1).padStart(2, '0');",
                  "const dd = String(target.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('sample_delivery_date', `${yyyy}-${mm}-${dd}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/inbound-slots?date={{sample_delivery_date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "inbound-slots"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{sample_delivery_date}}",
                  "description": "Delivery date (YYYY-MM-DD), must be between tomorrow and +30 days"
                }
              ]
            },
            "description": "Returns available inbound time slots (`HH:00`) for the specified date."
          },
          "response": []
        },
        {
          "name": "Get Outbound Delivery Slots",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const target = new Date();",
                  "target.setDate(target.getDate() + 5);",
                  "const yyyy = target.getFullYear();",
                  "const mm = String(target.getMonth() + 1).padStart(2, '0');",
                  "const dd = String(target.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('sample_delivery_date', `${yyyy}-${mm}-${dd}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/outbound-slots?date={{sample_delivery_date}}",
