{
  "info": {
    "_postman_id": "a9b8c7d6-e5f4-4321-8765-abcdef123456",
    "name": "SWMP External Partner Integration APIs",
    "description": "Postman Collection for SWMP External Partner Integration APIs (v1).\n\nAuthenticate via client credentials to obtain a 24-hour Bearer token, query contracts, check available delivery slots, inspect stock inventory, and create inbound or outbound requests synchronized directly with SAP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearer_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ensure sample_delivery_date is always dynamically valid (5 days from now)",
          "if (!pm.collectionVariables.get('sample_delivery_date')) {",
          "    const targetDate = new Date();",
          "    targetDate.setDate(targetDate.getDate() + 5);",
          "    const yyyy = targetDate.getFullYear();",
          "    const mm = String(targetDate.getMonth() + 1).padStart(2, '0');",
          "    const dd = String(targetDate.getDate()).padStart(2, '0');",
          "    pm.collectionVariables.set('sample_delivery_date', `${yyyy}-${mm}-${dd}`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "cl_live_9f83a1b2c3d4e5f67890",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "sec_live_abcdef1234567890",
      "type": "string"
    },
    {
      "key": "bearer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sample_contract_code",
      "value": "40000123",
      "type": "string"
    },
    {
      "key": "sample_gtin",
      "value": "06285000000000",
      "type": "string"
    },
    {
      "key": "sample_gln",
      "value": "6281000000000",
      "type": "string"
