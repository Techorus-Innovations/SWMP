  "item": [
    {
      "name": "1. Authentication",
      "description": "Endpoints for client credentials exchange and Bearer token management.",
      "item": [
        {
          "name": "Exchange Client Credentials for Bearer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Token received and saved to collection variables\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "    pm.collectionVariables.set('bearer_token', jsonData.access_token);",
                  "    console.log('Bearer token saved successfully!');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{client_id}}\",\n  \"client_secret\": \"{{client_secret}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "description": "Exchanges Client ID and Client Secret generated in the SWMP Partner Portal for a 24-hour Bearer token. The test script automatically saves the returned token into `{{bearer_token}}` for all protected collection calls."
          },
          "response": [
            {
              "name": "200 Token Issued",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"client_id\": \"cl_live_9f83a1b2c3d4e5f67890\",\n  \"client_secret\": \"sec_live_abcdef1234567890\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/token",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "token"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"1|abcdef1234567890...\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 86400,\n  \"business_partner\": {\n    \"bp_code\": \"BP100234\",\n    \"name\": \"Acme Pharmaceuticals LLC\"\n  }\n}"
            }
          ]
        }
      ]
    },
