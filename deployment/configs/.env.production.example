APP_NAME="SWMP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://<REPLACE_WITH_APP_SERVER_IP_OR_DOMAIN>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (Server 2)
DB_CONNECTION=mysql
DB_HOST=<REPLACE_WITH_DB_SERVER_IP>
DB_PORT=3306
DB_DATABASE=swmp
DB_USERNAME=swmp_user
DB_PASSWORD="<REPLACE_WITH_SECURE_PASSWORD>"

# Sessions, Queues and Cache (Using MySQL Database storage)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration: STRICTLY 'log' to prevent sending real emails
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@swmp.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
